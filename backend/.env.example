# Copy this file to backend/.env. Never commit backend/.env.

SNOOPSMOKE_HOST=127.0.0.1
SNOOPSMOKE_PORT=8787

# Required for ESP32 POST /api/alerts authentication.
SNOOPSMOKE_DEVICE_API_KEY=replace-with-a-long-random-device-key

# Optional dashboard protection. Leave empty for a local-only dashboard.
SNOOPSMOKE_DASHBOARD_API_KEY=

SNOOPSMOKE_ROOM_ID=ROOM-001
SNOOPSMOKE_OFFLINE_AFTER_MS=300000
SNOOPSMOKE_ALERT_COOLDOWN_MS=300000
SNOOPSMOKE_NOTIFY_POSSIBLE_SMOKE=true
SNOOPSMOKE_NOTIFY_CLEAR=false

# Optional: a provider/webhook that can turn accepted events into phone push notifications.
# Wi-Fi alone does not create phone notifications.
SNOOPSMOKE_NOTIFICATION_WEBHOOK_URL=

# Optional Blynk relay. Create the matching datastreams and events in Blynk first.
BLYNK_AUTH_TOKEN=
BLYNK_BASE_URL=https://blynk.cloud
BLYNK_VPIN_SMOKE=V0
BLYNK_VPIN_TEMPERATURE=V1
BLYNK_VPIN_HUMIDITY=V2
BLYNK_VPIN_STATUS=V3
BLYNK_VPIN_WIFI_RSSI=V4
BLYNK_EVENT_POSSIBLE_SMOKE=possible_smoke
BLYNK_EVENT_SMOKE_DETECTED=smoke_detected
BLYNK_EVENT_CLEAR=clear
